NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL publique du site (utilisée pour les liens Stripe et les e-mails).
# Laisser vide en développement : elle est déduite de la requête entrante.
NEXT_PUBLIC_SITE_URL=

# Facturation Stripe (optionnel — sans ces clés, la page Réglages affiche
# un message "facturation non configurée" au lieu du bouton d'abonnement).
# Trois formules : Solo (jusqu'à 3 salariés), Équipe (4 salariés ou plus) et
# Premium (donne accès aux Outils de calcul, quelle que soit la taille).
# STRIPE_PRICE_ID_EQUIPE peut rester vide : la formule Solo sert alors de repli.
# STRIPE_PRICE_ID_PREMIUM doit être configuré pour que la formule Premium et
# les Outils de calcul soient proposés à la souscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_EQUIPE=
STRIPE_PRICE_ID_PREMIUM=

# Stripe Connect : chaque artisan reçoit directement ses acomptes clients sur
# son propre compte Stripe (comptes "standard"), sans commission ArtisanRDV.
# STRIPE_CONNECT_WEBHOOK_SECRET vient d'un 2e point de terminaison webhook,
# créé avec l'option "connect" activée (événements des comptes connectés),
# pointant vers /api/stripe/webhook-connect.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Doit correspondre exactement à la valeur de private.settings.sync_secret
# dans la base Supabase : c'est ce qui autorise le webhook Stripe à mettre
# à jour le statut d'abonnement d'une entreprise.
SUPABASE_SYNC_SECRET=

# Requis uniquement pour inviter des membres d'équipe par e-mail
# (Dashboard > Équipe > Inviter). Clé secrète "service_role" du projet
# Supabase — ne jamais l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# Adresses e-mail (séparées par des virgules) autorisées à accéder à
# l'espace plateforme (/admin) : vue d'ensemble de toutes les entreprises
# clientes, abonnements, chiffre d'affaires. Réservé aux propriétaires
# du logiciel — nécessite aussi SUPABASE_SERVICE_ROLE_KEY ci-dessus.
PLATEFORME_ADMIN_EMAILS=

# Suivi des erreurs (Sentry, optionnel). Sans cette variable, le monitoring
# est simplement désactivé (aucune erreur en moins, juste pas de remontée).
# La DSN n'est pas un secret : https://sentry.io → Settings > Projects >
# [projet] > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Assistant IA (Premium, optionnel). Sans cette clé, la page Assistant
# affiche un message "non configuré" au lieu du chat. Clé secrète créée
# sur https://console.anthropic.com/settings/keys — ne jamais l'exposer
# côté client.
ANTHROPIC_API_KEY=

# Synchronisation Google Calendar (optionnel). Sans ces identifiants, le
# bouton "Connecter Google Calendar" (page Équipe) renvoie une erreur
# "non configuré". Identifiants OAuth créés sur
# https://console.cloud.google.com/apis/credentials (type "Application Web",
# URI de redirection : <URL du site>/api/google-calendar/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi d'e-mails (optionnel). Sans cette clé, l'assistant IA prépare les
# relances et e-mails clients mais ne les envoie pas lui-même (il fournit le
# texte à copier). Nécessite un domaine vérifié sur https://resend.com/domains
# (DKIM/SPF) — l'adresse d'expédition est contact@<domaine>, à adapter dans
# src/lib/email/client.ts si le domaine change. Clé créée sur
# https://resend.com/api-keys (permission "Sending access" suffit) — ne
# jamais l'exposer côté client.
RESEND_API_KEY=

# CAPTCHA Cloudflare Turnstile sur les formulaires publics (réservation,
# liste d'attente). Optionnel : sans ces clés, seule la protection de base
# (piège invisible + délai + limitation de débit par IP) reste active, sans
# widget visible. Créer un widget sur https://dash.cloudflare.com/?to=/:account/turnstile
# (type "Managed"), domaines : artisanrdv.com et artisanrdv.vercel.app.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY n'est pas un secret (exposée au navigateur) ;
# TURNSTILE_SECRET_KEY ne doit jamais l'être.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protège la tâche planifiée de rappels de rendez-vous (/api/cron/rappels-rdv,
# exécutée chaque jour à 17h UTC par Vercel Cron — voir vercel.json). Optionnel
# mais recommandé : sans cette valeur, la route reste accessible sans
# authentification (elle n'envoie rien de destructeur, mais autant la
# protéger). Choisis une chaîne aléatoire longue ; Vercel l'envoie
# automatiquement en en-tête Authorization lors de ses appels programmés dès
# qu'elle est définie dans les variables d'environnement du projet.
CRON_SECRET=

# Domaine personnalisé par artisan (optionnel — Dashboard > Widget & site web).
# Sans ces variables, cette section reste invisible pour les artisans. Permet
# à un artisan de faire pointer son propre sous-domaine (ex. rdv.sonsite.fr)
# vers sa page de réservation ArtisanRDV.
# VERCEL_API_TOKEN : jeton personnel créé sur
# https://vercel.com/account/tokens (portée limitée à ce projet si possible)
# — distinct des accès utilisés par les outils d'assistance au développement,
# propre au fonctionnement de l'application elle-même. Ne jamais l'exposer
# côté client.
# VERCEL_PROJECT_ID : Project Settings > General > Project ID (commence par "prj_").
# VERCEL_TEAM_ID : uniquement si le projet appartient à une équipe Vercel
# (Team Settings > General > Team ID, commence par "team_") ; laisser vide
# pour un compte personnel.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
